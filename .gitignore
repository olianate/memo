# Build output
.task/
.wails/
bin/
**/dist/
**/coverage/
**/.vite/
**/*.syso
third_party/wails/internal/commands/build_assets/android/.gradle/

# Node dependencies
frontend/node_modules/

# Local workspace and agent files (never commit)
.scratch/
probes/
prototype/
patches/
.agents/
AGENTS.md
**/AGENTS.md
docs/agents/
skills-lock.json

# The vendored Wails CLI embeds its setup-wizard frontend at compile time.
!third_party/wails/internal/setupwizard/frontend/dist/
!third_party/wails/internal/setupwizard/frontend/dist/**

# Vendored Wails: examples and generator test fixtures are not needed to build
third_party/wails/examples/
third_party/wails/internal/generator/testdata/

# Generated Wails installer bootstrapper
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# macOS 26 icon bundle: compiled from build/appicon.icon by actool (Xcode 26+) during
# `generate:icons` on macOS. Regenerated per build, so it is not committed.
build/darwin/Assets.car

# Logs and local secrets
**/*.log
**/*.tmp
**/.env
**/.env.*
!**/.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
